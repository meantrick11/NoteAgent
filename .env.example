# 模型配置（Provider、模型名、Base URL、API Key、能力验证）保存在 PostgreSQL。
# 启动后在 Settings → 模型与连接 添加、测试并启用；本文件不再保存模型配置。
# 旧版 var/model_settings/settings.json 仅由一次性导入器读取，迁移后保留 settings.pre-db.json。

NOTES_DIR=notes #Notes directory#
CHROMA_DIR=chromadb_persist #Chroma database directory#
CHROMA_COLLECTION=my_knowledge #Chroma collection name#

# SentenceTransformer / HuggingFace local cache. Relative path is under the repo root.
# Selected by the RAG evaluation (docs/evaluations/rag-v1-report.md §6):
# dev Recall@5 9/18 -> 17/18 vs all-MiniLM-L6-v2, at ~+350MB RAM and 1.6x query latency.
# Changing this changes the index fingerprint: 必须重建索引后才能启动。
EMBEDDING_MODEL=intfloat/multilingual-e5-small    #Embedding model name
EMBEDDING_CACHE_DIR=var/models #Embedding model cache directory
EMBEDDING_LOCAL_FILES_ONLY=false #First local run: false so the model can download. Docker compose overrides this to true.

# Chunking. Selected by the RAG evaluation (docs/evaluations/rag-v1-report.md):
# heading = 章节感知切块；EMBED_HEADING_PREFIX = 把章节路径拼进被嵌入的文本（引用原文不变）。
# 改动这两项会改变索引配置指纹，必须重建索引：界面「重建并修复/重建并切换」，
# 或 uv run python scripts/index_notes.py --all --dry-run 先看差异。
CHUNK_STRATEGY=heading #char or heading#
EMBED_HEADING_PREFIX=true #prefix the section path into the embedded text#

HOST=127.0.0.1 #Host address#
PORT=8000 #Port number#
LOG_DIR=var/logs #Log directory#
LOG_LEVEL=DEBUG #Log level#

# Retrieval 的 embedding 状态目录（settings.json）。
# 聊天模型配置已迁移到 PostgreSQL；此目录只保留 embedding 状态。
# 迁移前旧模型配置会备份为 settings.pre-db.json（0600），仅遗留导入器读取。
# 当前启用（active）的模型不能直接编辑或删除，先启用另一个模型。
# Docker：该目录仍需持久卷，用于 embedding 状态与遗留备份（见 docker-compose.yml）。
MODEL_SETTINGS_DIR=var/model_settings

# PostgreSQL. Prefix must be postgresql+psycopg://  (not postgresql://)
# Docker compose sets DATABASE_URL for you; leave this commented when using Docker.
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/noteagent

# Compression thresholds (all token estimates use chars/4).
# 模型上下文窗口现在保存在模型配置行，不再用 CHAT_CONTEXT_WINDOW 覆盖。
CONTEXT_TRIGGER_RATIO=0.8
CONTEXT_TARGET_RATIO=0.6
CONTEXT_STUB_PREVIEW_TOKENS=1000
CONTEXT_ARGS_PREVIEW_CHARS=500
CONTEXT_OUTPUT_RESERVE=1024
CONTEXT_SAFETY_BUFFER=512
CHAT_MAX_TOOL_HOPS=8
