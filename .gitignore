# API KEY files
.env
.env.local

# Python virtual enviroment
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# privacy notes (keep directory README)
notes/*
!notes/README.md

# RAG eval: corpus note bodies and annotated datasets stay local (private notes).
# Committed: corpus manifest/audit, run summaries, code, tests, docs.
evals/rag/corpus/*/notes/
evals/rag/corpus/*/sources/
evals/rag/queries*.json
evals/rag/queries*.jsonl
evals/agent/rag_cases*.json
evals/agent/rag_cases*.jsonl

# chromadb persist data
chromadb_persist/

# runtime data (keep directory README)
var/*
!var/README.md

# shadow note version repository (private Git history; never the code repo .git)
var/notes_history/

# legacy log dir
logs/

# IDE
.idea/
.vscode/
*.swp

# Frontend (Vue + Vite): 依赖与产物都不入库，由 npm ci / npm run build 生成
node_modules/
frontend/playwright-report/
frontend/test-results/
frontend/coverage/
frontend/node_modules/
frontend/.vite/
src/noteagent/web/dist/
